{
  "name": "api-sentinel",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "api-sentinel": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "license": "MIT",
  "description": "Dependabot for APIs \u2014 snapshot vendor OpenAPI specs, detect breaking changes, pinpoint affected code, generate fixes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Snorbu/api-sentinel.git"
  },
  "keywords": [
    "openapi",
    "breaking-changes",
    "ci",
    "devtools",
    "api",
    "llm",
    "dependabot"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ]
}
